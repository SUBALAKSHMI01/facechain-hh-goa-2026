# Secrets / credentials — never commit
.env
*.env
*credentials*.json
*service-account*.json
*key*.json

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# InsightFace model cache (large binary files, fetched on first run)
.insightface/

# Generated artifacts
artifacts/evidence/*.json
artifacts/logs/*.log
examples/output/*
# Don't commit real test images, but keep the input/ directory tracked
# (the README there explains the intended use).
examples/input/*
!examples/input/.gitkeep

# OS
.DS_Store
