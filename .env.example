# --- Reverse image search --------------------------------------------
# Path to a Google Cloud service-account JSON key with Vision API access.
# Required for Phase 1's reverse-image-search step.
GOOGLE_APPLICATION_CREDENTIALS=

# Not required for Phase 1 (Google Cloud Vision is the primary provider).
# Reserved for a future/alternate provider.
SERPAPI_KEY=

# --- Confidence engine (Phase 2 — read now, not yet used) -------------
FACE_WEIGHT=0.55
IMAGE_WEIGHT=0.25
SEARCH_WEIGHT=0.20

FACE_MATCH_THRESHOLD=0.70
FINAL_MATCH_THRESHOLD=0.75

# --- Blockchain (Phase 3 — Sepolia) -----------------------------------
# Sepolia RPC endpoint, e.g. https://sepolia.infura.io/v3/<KEY> or
# https://ethereum-sepolia.publicnode.com for a public endpoint.
# 11155111 is Sepolia's chain id.
SEPOLIA_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=
CHAIN_ID=11155111
